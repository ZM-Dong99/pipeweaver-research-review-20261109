read_verilog -formal -sv "D:/verilog_lab/PipeWeaver/eda/experiments/verified_optimizer_acceptance_20261107/priority_default/inputs/original.v"
chparam -set LSB_HIGH_PRIORITY 0 priority_encoder
chparam -set WIDTH 256 priority_encoder
hierarchy -check -top priority_encoder
flatten
rename priority_encoder pw_gold
design -stash pw_gold_design
read_verilog -formal -sv "D:/verilog_lab/PipeWeaver/eda/experiments/verified_optimizer_acceptance_20261107/priority_default/inputs/sampled_no_sta.v"
chparam -set LSB_HIGH_PRIORITY 0 priority_encoder
chparam -set WIDTH 256 priority_encoder
hierarchy -check -top priority_encoder
flatten
rename priority_encoder pw_cand
design -stash pw_cand_design
design -reset
design -copy-from pw_gold_design pw_gold
design -copy-from pw_cand_design pw_cand
